import java.util.Scanner;
class Employee
{
    String name;
    int  age;
    int grade ;
    double salary;

    public Employee()
    {
        this.name="UNKNOWN";
        this.age=0;
        this.grade=0;
        this.salary=-0;
    }
    public Employee(String name,int age,int grade,double salary)
    {
        this.name=name;
        this.age=age;
        this.grade=grade;
        this.salary=salary;
    }
    public Employee(Employee emp1)
    {
        this.name=emp1.name;
        this.age=emp1.age;
        this.grade=emp1.grade;
        this.salary=emp1.salary;
    }

    public void showDetails()
    {
        System.out.println("The Name of Employee is "+name+"  "+"The age of Employee is "+age+"  "+"The Grade of Employee is "+grade+"  "+"The Salary of Employee is "+salary);
    }

    public void Increment()
    {
        if (grade >= 17) 
        {
            salary +=salary *0.05;
        } else if (grade < 17 && grade >= 12) 
        {
            salary +=salary * 0.10;
        } else if (grade < 12 && grade >= 8) 
        {
            salary += salary * 0.15;
        } else if (grade < 8)
         {
            salary += salary * 0.20;
        }
}
    public void input()
    {
        Scanner sc= new Scanner(System.in);
        System.out.println("Enter the Name of Employee ");
        name=sc.nextLine();
        System.out.println("Enter the Age of Employee");
        age=sc.nextInt();
        System.out.println("Enter the Salary of Employee");
        salary=sc.nextDouble();
        System.out.println("Enter the grade of Employee");
        grade=sc.nextInt();
    }

    public double getSalary()
    {
        return salary;
    }
}
public class Qno3 {
    static double addsalary(Employee emp,Employee emp1)
    {
        return emp.getSalary()+emp1.getSalary();
    }
