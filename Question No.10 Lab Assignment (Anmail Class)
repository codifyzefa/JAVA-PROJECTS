class Animal {
    int speed;
    double price;
    String diet;

    public Animal(int speed, double price, String diet) {
        this.speed = speed;
        this.price = price;
        this.diet = diet;
    }

    public void printInfo() {
        System.out.println("Speed: " + speed);
        System.out.println("Price: " + price);
        System.out.println("Diet: " + diet);
    }
}


class Cow extends Animal {
    public Cow(int speed, double price, String diet) {
        super(speed, price, diet); 
    }
    @Override
    public void printInfo() {
        System.out.println("Cow Information:");
        super.printInfo();
    }
}
