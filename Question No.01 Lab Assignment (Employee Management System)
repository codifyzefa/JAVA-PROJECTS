class Employee
{
String name;
String Address;
int year;

    public Employee()
    {
        
    }
    public Employee(String name,String Address,int year)
    {
        this.name=name;
        this.Address=Address;
        this.year=year;
    }
    public Employee (Employee emp)
    {
        this.name=emp.name;
        this.Address=emp.Address;
        this.year=emp.year;
    }
    public void setDetails(String name,String Address,int year)
    {
        this.name=name;
        this.Address=Address;
        this.year=year;
    }
    public void showDetails()
    {
        System.out.println("The Name of Employee is : "+name+" : The Year of Joining of Employee is : "+year+" : The Address of the Employee is "+Address);
    }
}
