class Employee {
   
    private String name;
    private int yearOfJoining;
    private String address;

    public void setDetails(String name, int yearOfJoining, String address) {
        this.name = name;
        this.yearOfJoining = yearOfJoining;
        this.address = address;
    }

   
    public void print() {
        System.out.println("The Name of Employee is "+name+" : "+" The Year of Joining is "+yearOfJoining+" : "+" The Address of Employee is "+address);
    }
}

